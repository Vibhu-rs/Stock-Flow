# Database connection
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=replace-me
DB_NAME=your-database
DB_SSL=true
# Optional: PEM certificate contents (or keep ca.pem next to app.py)
DB_CA=

# Application secrets: use a long, random value and never commit a real .env file
JWT_SECRET=replace-with-a-long-random-secret
STORE_CODE=replace-with-a-private-staff-signup-code
PORT=3000

# Store details printed on receipts / invoices
STORE_NAME=Your Store Name
STORE_ADDRESS=Your full business address
STORE_PHONE=
STORE_EMAIL=

# GST setup. STORE_GSTIN's first two digits are the GST state code.
# STORE_STATE should be a state name such as Delhi; STORE_STATE_CODE is the GST state code such as 07.
STORE_GSTIN=
STORE_STATE=Delhi
STORE_STATE_CODE=07
